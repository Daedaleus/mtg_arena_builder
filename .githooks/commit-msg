#!/bin/sh
# Checks the first line of the commit message: conventional commits with the
# matching icon after the colon, e.g.
#
#   feat(sim): ✨ add prowess to the race
#   fix: 🐛 keep settings when the file is damaged
#
# Turn on (once per clone):  git config core.hooksPath .githooks
# Types and icons: CONTRIBUTING.md, section "Commit messages".

# Compare byte by byte: under UTF-8 the sed of Git for Windows does not
# recognise emojis outside the basic plane (👷, 🐛 …) as characters.
LC_ALL=C
export LC_ALL

first=$(sed -n '1p' "$1" | tr -d '\r')

# Let messages generated by Git itself through.
case "$first" in
    "Merge "* | "Revert \""* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

fail() {
    echo "commit-msg: $1" >&2
    echo "  got:      $first" >&2
    echo "  expected: <type>(<optional scope>): <icon> <description>" >&2
    echo "  e.g.      feat(sim): ✨ add prowess to the race" >&2
    echo "  types:    feat ✨  fix 🐛  docs 📝  style 🎨  refactor ♻️  perf ⚡️" >&2
    echo "            test ✅  build 📦️  ci 👷  chore 🔧  revert ⏪️" >&2
    exit 1
}

type=$(printf '%s\n' "$first" | sed -n 's/^\([a-z]*\)\(([a-z0-9/_.-]*)\)\{0,1\}!\{0,1\}: .*$/\1/p')
[ -n "$type" ] || fail "first line is not a conventional commit"
rest=${first#*: }

# Icons with and without variation selector (U+FE0F), depending on keyboard/editor.
case "$type" in
    feat) icons="✨" ;;
    fix) icons="🐛" ;;
    docs) icons="📝" ;;
    style) icons="🎨" ;;
    refactor) icons="♻️ ♻" ;;
    perf) icons="⚡️ ⚡" ;;
    test) icons="✅" ;;
    build) icons="📦️ 📦" ;;
    ci) icons="👷" ;;
    chore) icons="🔧" ;;
    revert) icons="⏪️ ⏪" ;;
    *) fail "unknown type '$type'" ;;
esac

for icon in $icons; do
    case "$rest" in
        "$icon "?*) exit 0 ;;
    esac
done
fail "type '$type' needs the icon ${icons%% *} after the colon"
